;; ---------------------------------------------------------------------------
;; Shared kanata config — used by both kanata-mac.kbd and kanata-linux.kbd.
;;
;; Mirrors .config/karabiner/karabiner.json. Platform-specific app launchers
;; (chrome, kitty, slack, ...) are defined in the platform entry files; this
;; file only references them via @<name>.
;;
;; Notes:
;;   * macOS launchers use `open -a`. Linux launchers shell out to the binary.
;;     Both rely on `danger-enable-cmd yes` plus kanata started with
;;     `--danger-enable-cmd-bool` (mac) or `--cmd-enabled` flag (linux).
;;   * Karabiner's `frontmost_application_unless` (skip remap in terminals)
;;     has no Kanata equivalent. Ctrl+hjkl / np / du / w chords apply
;;     globally — disable them inside the terminal/editor if you need raw
;;     ctrl+<key> there.
;; ---------------------------------------------------------------------------

(defcfg
  process-unmapped-keys yes
  danger-enable-cmd     yes
  concurrent-tap-hold   yes
)

(defsrc
  esc  1    2    3    4    5    6    7    8    9    0    -    =    bspc
  tab  q    w    e    r    t    y    u    i    o    p    [    ]    \
  caps a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft z    x    c    v    b    n    m    ,    .    /    rsft
  lctl lmet lalt           spc            ralt rmet rctl
)

(defvar
  tap-time  200
  hold-time 200
)

(defalias
  ;; Tab: tap = tab, hold = enter hyper layer
  tab-hyper (tap-hold $tap-time $hold-time tab (layer-while-held hyper))

  ;; Caps <-> Left Control swap
  caps→ctl lctl
  ctl→caps caps

  ;; Inside the hyper layer, holding `w` enters the w sublayer.
  w-sub (layer-while-held hyper-w)
)

;; ---------------------------------------------------------------------------
;; Chords
;;   - lmet+spc briefly held -> enter hyper layer (alt entry alongside Tab)
;;   - ctrl + h/j/k/l        -> arrow keys
;;   - ctrl + n/p            -> down / up
;;   - ctrl + d/u            -> page down / page up
;;   - ctrl + w              -> opt/alt + backspace (delete word back)
;;   - ctrl + [              -> escape
;; Bound on both `caps` and `lctl` since we swap them above.
;; ---------------------------------------------------------------------------

(defchordsv2
  (lmet spc) (layer-while-held hyper) 80 first-release ()

  (caps h)   left   60 first-release ()
  (caps j)   down   60 first-release ()
  (caps k)   up     60 first-release ()
  (caps l)   right  60 first-release ()
  (caps n)   down   60 first-release ()
  (caps p)   up     60 first-release ()
  (caps d)   pgdn   60 first-release ()
  (caps u)   pgup   60 first-release ()
  (caps w)   A-bspc 60 first-release ()
  (caps [)   esc    60 first-release ()

  (lctl h)   left   60 first-release ()
  (lctl j)   down   60 first-release ()
  (lctl k)   up     60 first-release ()
  (lctl l)   right  60 first-release ()
  (lctl n)   down   60 first-release ()
  (lctl p)   up     60 first-release ()
  (lctl d)   pgdn   60 first-release ()
  (lctl u)   pgup   60 first-release ()
  (lctl w)   A-bspc 60 first-release ()
  (lctl [)   esc    60 first-release ()
)

;; ---------------------------------------------------------------------------
;; Layers
;; ---------------------------------------------------------------------------

(deflayer base
  esc        1    2    3    4    5    6    7    8    9    0    -    =    bspc
  @tab-hyper q    w    e    r    t    y    u    i    o    p    [    ]    \
  @caps→ctl  a    s    d    f    g    h    j    k    l    ;    '    ret
  lsft       z    x    c    v    b    n    m    ,    .    /    rsft
  @ctl→caps  lmet lalt                spc           ralt rmet rctl
)

;; Hyper layer (Tab held or Cmd/Super+Space held):
;;   w (hold) -> hyper-w sublayer
;;   s -> launcher / Spotlight
;;   h -> Slack
;;   j -> kitty
;;   k -> Chrome
;;   l -> Cursor
;;   n -> alacritty
;;   m -> Gmail
;;   , -> Google Meet
;;   . -> ClickUp
;;   p -> Postman
(deflayer hyper
  _          _    _    _    _    _    _    _    _    _    _    _    _    _
  _          _    @w-sub _  _    _    _    _    _    _    @postman _ _ _
  _          _    @spotlight _ _ _   @slack @kitty @chrome @cursor _ _ _
  _          _    _    _    _    _    @alacritty @gmail @meet @clickup _ _
  _          _    _                   _              _    _    _
)

;; Hyper + w sublayer: j -> Chrome
(deflayer hyper-w
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _    _    _    _    _    @chrome _    _    _    _    _
  _    _    _    _    _    _    _    _    _    _    _    _
  _    _    _                   _              _    _    _
)
